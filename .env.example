# Copy this file to .env and fill in your keys. Never commit .env.

# Needed to run the assistant (python -m friday.voice).
# Cloudflare Workers AI: account id and an API token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OpenRouter: last fallback in the provider chain (free models).
OPENROUTER_API_KEY=

# Optional: only for the probe tools (friday/probe.py, friday/catalog.py),
# which check which providers are reachable. Not used by the assistant itself.
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=